# Required. Every device signs in with this (openssl rand -base64 24).
RELAY_TOKEN=
# Required. Seals stored app passwords (openssl rand -base64 32). Keep it out of backups of /data.
RELAY_KEY=
# For Outlook accounts: the https address Microsoft can reach this relay at.
RELAY_PUBLIC_URL=
# For iPhones and iPads (Apple Push Notification service, token auth):
# APNS_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=design.snds.vale
# For Android with Google Play services (Firebase Cloud Messaging):
# FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
